#!/usr/bin/env bash
# Local pre-push gate for this repo (no GitHub Actions -- same convention as
# the rest of this codebase). Runs the discovery-phase checks: every fixture's
# checksum recomputes correctly from its own bytes, and fields.json's byte
# ranges cover every report shape with no gaps. Full cargo fmt/test/clippy
# wiring lands with the first Rust code, in the follow-up implementation PR.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> verify-checksums.js"
node scripts/verify-checksums.js

echo
echo "==> check-coverage.js"
node scripts/check-coverage.js
