#!/usr/bin/env bash
# Local pre-push gate for this repo (no GitHub Actions -- same convention as
# the rest of this codebase). Runs the discovery-phase checks:
#   - verify-checksums.js: the checksum formula matches the vendor's own
#     hardcoded constants, independent of fixtures/
#   - check-coverage.js: fields.json's byte ranges cover every report shape
#     with no gaps; every fixture has the required schema keys, is exactly
#     64 bytes, has a checksum that recomputes correctly from its own bytes,
#     has reserved/padding bytes that are actually zero, and (where present)
#     a decoded_payload that matches the raw bytes
#   - check-raw-consistency.js: fixtures/cap1.json actually matches
#     fixtures/raw/cap1-hidlog.json (the minimally processed capture
#     evidence) byte for byte -- the one check that isn't just the model
#     checking itself
# Plus, since Milestone 1 (native set-time): cargo fmt/test/clippy for the
# Rust binary. Requires a Rust toolchain (https://rustup.rs) to be installed.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> verify-checksums.js"
node scripts/verify-checksums.js

echo
echo "==> check-coverage.js"
node scripts/check-coverage.js

echo
echo "==> check-raw-consistency.js"
node scripts/check-raw-consistency.js

echo
echo "==> cargo fmt --check"
cargo fmt --check

echo
echo "==> cargo test --locked"
cargo test --locked

echo
echo "==> cargo clippy --locked --all-targets -- -D warnings"
cargo clippy --locked --all-targets -- -D warnings
